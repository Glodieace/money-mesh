DEMO_MODE=true
DEMO_PASSWORD=MoneyMeshDemo!2026
JWT_SECRET=replace-this-with-a-random-secret-before-deployment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+psycopg://moneymesh:moneymesh-demo@localhost:5432/moneymesh
# Keep both production demo opt-ins false except on an intentionally synthetic hackathon deployment.
ALLOW_SYNTHETIC_DEMO_IN_PRODUCTION=false
ALLOW_LOCAL_EVM_IN_PRODUCTION=false
# Compose starts a local Neo4j by default; set these four values to use Aura instead.
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://854e0199.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=LtqMwHVNR71GO6Up7iBSgRxgJWoqEmWOCH0xGlLosoc
NEO4J_DATABASE=Instance01
# LOCAL EVM BLOCKCHAIN; no RPC provider, wallet key, or contract address needed locally.
BLOCKCHAIN_MODE=local
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
EVIDENCE_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337
# CHAIN_ID remains supported as a legacy alias.
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
APP_ENV=development
RISK_HIGH_VALUE_PAISE=8500000
